# Copy to .env in the project root and fill in your own values.
# Never commit the real .env file.

CRMDEDUP_DB_PATH=data/crmdedup.db

# CRM backend — a Pipedrive-shaped client is bundled; swap for another CRM's
# client behind the same interface if you use something else.
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_DOMAIN=
